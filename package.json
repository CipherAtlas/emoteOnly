{
  "name": "emoteonly",
  "version": "1.1.0",
  "private": true,
  "description": "A tiny Firefox utility for emotes-only Twitch chat.",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:firefox": "node tests/firefox-smoke.mjs",
    "test:live": "node tests/firefox-live.mjs",
    "lint": "web-ext lint --source-dir extension --warnings-as-errors",
    "build": "web-ext build --source-dir extension --artifacts-dir artifacts --overwrite-dest"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "web-ext": "10.8.0"
  }
}
